# Claude Code transcripts hold the account email and everything read in a session: keep them local.
# The decision logs (_meta/sessions/*/decisions.md) and the decision page are committed.
_meta/sessions/runs/
_meta/sessions/*/session.jsonl
_meta/sessions/*/subagents/
_meta/sessions/*/manifest.json
_meta/sessions/*/digest.txt

# Machine-specific Claude Code settings (e.g. autoMemoryDirectory, an absolute path)
.claude/settings.local.json

# Python bytecode cache
__pycache__/

# Plan-usage readings saved by the status line (local; times and percentages only)
_meta/usage/

# Godot binary unpacked in the repo folder (laptop); _tools/godot_path.py finds it
Godot_v4.2.1-stable_win64.exe/

# screen recordings dropped at the repo root (designer, 2026-11-23)
/*.mp4
