{
  "statusLine": {
    "type": "command",
    "command": "python -I \"${CLAUDE_PROJECT_DIR:-.}/_tools/statusline.py\""
  },
  "permissions": {
    "allow": [
      "Bash(python -I _tools/links.py)",
      "Bash(python -I _tools/test_generate.py)",
      "Bash(python -I _tools/consistency.py)",
      "Bash(python -I _tools/test_goal_agent.py)",
      "Bash(python -I _tools/links.py *)",
      "Bash(python -I _tools/test_generate.py *)",
      "Bash(python -I _tools/consistency.py *)",
      "Bash(python -I _tools/test_goal_agent.py *)",
      "Bash(python -I _tools/godot_run.py *)",
      "Bash(python -I _tools/godot_path.py --path game*)",
      "PowerShell(python -I _tools/godot_path.py --path game*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/budget_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking plan usage"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/guard_shell.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/log_subagent.py\"",
            "timeout": 30,
            "statusMessage": "Logging subagent run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/log_session.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/context_guard.py\" --window 1000000",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/_tools/context_guard.py\" --window 1000000",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
