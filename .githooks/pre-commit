#!/bin/sh
# Refuse a commit whose docs contradict the code and config they describe, or whose links break.
# Enabled per machine with: git config core.hooksPath .githooks  (the end-of-day skill sets it up)
cd "$(git rev-parse --show-toplevel)" || exit 1
python -I _tools/consistency.py || {
    echo "pre-commit: docs disagree with code (above). Generated sections: python -I _tools/sync_docs.py" >&2
    exit 1
}
python -I _tools/links.py > /dev/null || {
    python -I _tools/links.py >&2
    echo "pre-commit: broken links (above)" >&2
    exit 1
}
