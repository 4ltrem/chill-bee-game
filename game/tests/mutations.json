  "find": "\t_set_speed(1.0)\n\tfor value_name in _rows:",
  "replace": "\tfor value_name in _rows:",
  "expect": [
   "t_speed_reset"
  ],
  "suite": "unit"
 },
 {
  "name": "a script reads Time.get_ticks_msec",
  "file": "scripts/cell_flight.gd",
  "find": "static var _warned: Dictionary = {}",
  "replace": "static var _warned: Dictionary = {}\nstatic var _born: int = Time.get_ticks_msec()",
  "expect": [
