  "find": "tween.tween_callback(cell.show)",
  "replace": "tween.set_ignore_time_scale(true)\n\ttween.tween_callback(cell.show)",
  "expect": [
   "t_speed_cell_flight"
  ],
  "suite": "unit"
 },
 {
  "name": "hive lid tween ignores the game speed",
  "file": "scripts/lid_motion.gd",
  "find": "_tween = _lid.create_tween()",
  "replace": "_tween = _lid.create_tween().set_ignore_time_scale(true)",
  "expect": [
   "t_speed_lid_lift"
  ],
  "suite": "unit"
 },
 {
  "name": "jar cycle timer reads the wall clock",
  "file": "scripts/centrifuge.gd",
  "find": "_bottle_timer += delta ",
  "replace": "_bottle_timer += delta / maxf(Engine.time_scale, 0.001) ",
  "expect": [
   "t_speed_jar_cycle"
  ],
  "suite": "unit"
 },
 {
  "name": "hotkeys wrap around at the ends",
  "file": "scripts/dev_panel.gd",
  "find": "clampi(index + direction, 0, SPEEDS.size() - 1)",
  "replace": "posmod(index + direction, SPEEDS.size())",
  "expect": [
   "t_speed_hotkeys"
  ],
  "suite": "unit"
 },
 {
  "name": "speed tag always shown",
  "file": "scripts/dev_panel.gd",
  "find": "_speed_tag.visible = not is_equal_approx(Engine.time_scale, 1.0)",
  "replace": "_speed_tag.visible = true",
  "expect": [
   "t_speed_tag",
   "t_speed_reset"
  ],
  "suite": "unit"
 },
 {
  "name": "Reset to defaults keeps the speed",
